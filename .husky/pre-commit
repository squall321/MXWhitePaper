pnpm -w schema:validate
pnpm -r --if-present run typecheck

# FR-17 codegen drift guard — fast (<5s) check that committed artifacts
# match the SSOT. Skip silently if optional tooling is missing locally.
ROOT="$(git rev-parse --show-toplevel)"

# 1) Schema codegen drift (TS + Pydantic)
if pnpm -w schema:gen >/dev/null 2>&1; then
  if ! git diff --quiet -- "$ROOT/apps/web/src/types/document.ts" "$ROOT/apps/api/app/schemas/document.py"; then
    echo "✗ Schema codegen drift detected. Run: make codegen && git add apps/web/src/types/document.ts apps/api/app/schemas/document.py"
    exit 1
  fi
else
  echo "⚠ pnpm schema:gen unavailable — skipping codegen drift check."
fi

# 2) OpenAPI runtime spec drift — prefers the running api container so the
# hook stays under 5s. Skip if neither container nor local Python deps work.
if apptainer instance list 2>/dev/null | grep -q mxwp_api; then
  apptainer exec instance://mxwp_api /bin/sh -c "cd /workspace && python3 apps/api/app/scripts/dump_openapi.py" >/dev/null 2>&1 || true
  if ! git diff --quiet -- "$ROOT/apps/api/openapi.json"; then
    echo "✗ FastAPI OpenAPI drift detected. Run: make openapi-dump && git add apps/api/openapi.json"
    exit 1
  fi
elif command -v python3 >/dev/null 2>&1 && python3 -c "import fastapi" 2>/dev/null; then
  python3 "$ROOT/apps/api/app/scripts/dump_openapi.py" >/dev/null 2>&1 || true
  if ! git diff --quiet -- "$ROOT/apps/api/openapi.json"; then
    echo "✗ FastAPI OpenAPI drift detected. Run: make openapi-dump && git add apps/api/openapi.json"
    exit 1
  fi
else
  echo "⚠ python3 + fastapi not available locally — skipping OpenAPI drift check (CI will catch it)."
fi

# 3) RAG index drift guard — if any tracked widget/rule source is staged,
# verify dist/llm-docx-toolkit/rag/index.lock is up to date with the
# current source hashes. Skip silently if chunker.py isn't available
# (e.g. shallow worktree, contributor without the toolkit).
STAGED_RAG_SOURCES=$(git diff --cached --name-only | grep -E '^(apps/api/app/services/(docx_import|widget_markers)\.py|packages/shared/schemas/document\.json|docs/llm-(input-rules|viewer-guide)\.md|dist/llm-docx-toolkit/llm-system-prompt\.md|docs/archive/[^/]+/_INDEX\.md)$' || true)
if [ -n "$STAGED_RAG_SOURCES" ] && [ -f "$ROOT/dist/llm-docx-toolkit/rag/chunker.py" ] && [ -f "$ROOT/dist/llm-docx-toolkit/rag/index.lock" ]; then
  if command -v python3 >/dev/null 2>&1; then
    if ! python3 "$ROOT/dist/llm-docx-toolkit/rag/chunker.py" --check >/dev/null 2>&1; then
      echo "✗ RAG index is out of date. Run: python3 dist/llm-docx-toolkit/rag/chunker.py && git add dist/llm-docx-toolkit/rag/index.lock dist/llm-docx-toolkit/rag/chunks.jsonl"
      exit 1
    fi
  else
    echo "⚠ python3 unavailable — skipping RAG index drift check (CI will catch it)."
  fi
fi

# 4) Knowledge-asset coverage guard (지식 자산 로드맵 Phase 1) — schema 에
# block 이 추가되면 작성/읽기 가이드에 해당 항목이 *없을 때* 커밋을 막는다.
# 의미 드리프트 검출 — 위의 hash 기반 RAG check 가 못 잡는 영역.
STAGED_COVERAGE_SOURCES=$(git diff --cached --name-only | grep -E '^(packages/shared/schemas/document\.json|docs/llm-(input-rules|viewer-guide)\.md)$' || true)
if [ -n "$STAGED_COVERAGE_SOURCES" ] && [ -f "$ROOT/dist/llm-docx-toolkit/rag/coverage_check.py" ]; then
  if command -v python3 >/dev/null 2>&1; then
    if ! python3 "$ROOT/dist/llm-docx-toolkit/rag/coverage_check.py" --quiet; then
      echo "✗ 신규/변경 block 이 LLM 가이드에 미반영. 위 누락 목록을 docs/llm-input-rules.md · docs/llm-viewer-guide.md 에 추가할 것."
      exit 1
    fi
  fi
fi
