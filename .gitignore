# dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/
*.egg-info/
*.pyc

# build outputs
# (The top-level `dist/` was historically a catch-all for Webpack/Vite output;
# we now have one tracked sub-tree under it, so we ignore only the specific
# build folders and let the rest fall through.)
dist/*
!dist/llm-docx-toolkit/
apps/web/dist/
apps/api/dist/
build/
*.tsbuildinfo
.tsbuild-node/

# env / secrets
.env
.env.*
!.env.example

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# Claude Code / agent-local state (never commit — local-only memory/cache)
.claude/

# OS
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# misc
.cache/
coverage/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# bkit / claude
.bkit/runtime/
.bkit/snapshots/
.koo-llm-sessions/

# storage volumes (when binding locally)
infra/data/

# Apptainer build artefacts (100MB~210MB each — pulled/built locally)
*.sif

# bkit/PDCA local state (per-developer; not part of the repo contract)
.bkit/state/

# husky auto-generated
.husky/_/

# build/run logs (keep dir? no — flush via cron)
infra/logs/*.log
infra/logs/*.html
infra/logs/_*.sh
infra/logs/sprint*-render-check.mjs

# playwright artefacts
infra/logs/e2e-report/
apps/web/test-results/
apps/web/playwright-report/
apps/web/.playwright/
.playwright-mcp/
new-ux-overview.png

# root-level ad-hoc 캡처/덱 (코드와 무관, 외부 공유 산출물)
/*.html
/*.png

# DB backups (contain document data + user emails — not part of the repo)
infra/backups/

# meilisearch on-disk data (binary LMDB files, only ever live)
data.ms/

# offline package cache (700MB — produced by scripts/download-packages.sh,
# copied to air-gapped hosts via tar bundle, not part of the repo).
# 폴더 자체는 살려두고 내용물만 ignore — 그래야 apptainer .deb 만 !exception 으로
# 살릴 수 있음 (git: 폴더가 ignored면 안의 파일도 ! 무효).
infra/packages/deb/*
infra/packages/npm/*
infra/packages/pip/*
infra/packages/sif/*

# 단 — apptainer 1.3.6 .deb (27 MB) 는 항상 commit. target 서버가 인터넷
# 차단 환경이라도 git pull + install-apptainer-1.3.6.sh 한 줄로 즉시 설치.
!infra/packages/deb/apptainer_*.deb

# user-local apptainer install (project-internal, see infra/scripts/install-apptainer-*.sh)
infra/apptainer/bin-1.3.6/
.tmp/
