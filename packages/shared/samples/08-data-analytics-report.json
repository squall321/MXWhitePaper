  "sections": [
    {
      "id": "01K08D5R0000000000000000S1",
      "number": "1",
      "level": 1,
      "title": "실시간 지표",
      "blocks": [
        {
          "type": "paragraph",
          "id": "01K08D5R0000000000000B0001",
          "text": "본 섹션의 모든 위젯은 사내 위젯 레지스트리에서 동적으로 갱신된다. 마지막 갱신 시각은 각 위젯 헤더에 표시된다."
        },
        {
          "type": "data-source",
          "id": "01K08D5R0000000000000B0002",
          "endpoint": "/api/v1/widgets/kpi-finance-daily-summary",
          "params": {},
          "render": "kpi-cards",
          "refreshInterval": 120
        },
        {
          "type": "data-source",
          "id": "01K08D5R0000000000000B0003",
          "endpoint": "/api/v1/widgets/chart/sales-trend",
          "params": { "team": "finance", "days": 30 },
          "render": "chart",
          "refreshInterval": 300
        },
        {
          "type": "data-source",
          "id": "01K08D5R0000000000000B0004",
          "endpoint": "/api/v1/widgets/table/region-breakdown",
          "params": { "period": "2026-Q1" },
          "render": "table"
        },
        {
          "type": "dashboard-embed",
          "id": "01K08D5R0000000000000B0005",
          "provider": "grafana",
          "panelId": "mx-q1-overview",
          "params": { "from": "now-90d", "to": "now" }
        },
        {
          "type": "dashboard-embed",
          "id": "01K08D5R0000000000000B0006",
          "provider": "tableau",
          "panelId": "mx-revenue-by-region"
        }
      ],
      "subsections": [
        {
          "id": "01K08D5R0000000000000000S2",
          "number": "1.1",
          "level": 2,
          "title": "투자 회수 시뮬레이터",
          "blocks": [
            {
              "type": "calculator",
              "id": "01K08D5R0000000000000B0007",
              "label": "ROI(%)",
              "inputs": [
                { "name": "revenue", "label": "예상 매출 (M원)", "kind": "number", "default": 500 },
                { "name": "cost", "label": "총 투자비 (M원)", "kind": "number", "default": 120 },
                { "name": "discount", "label": "할인율 (%)", "kind": "number", "default": 5 }
              ],
              "formula": "((revenue - cost) / cost) * 100 - discount"
            }
          ],
          "subsections": []
        }
      ]
    },
    {
