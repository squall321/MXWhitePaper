      "title": "ASP 계산식",
      "blocks": [
        {
          "type": "math",
          "id": "01J9X1Y2Z3A4B5C6D7E8F9G4B2",
          "expression": "ASP = \\frac{\\text{Total Revenue}}{\\text{Units Sold}}",
          "display": "block"
        },
        {
          "type": "code",
          "id": "01J9X1Y2Z3A4B5C6D7E8F9G4B3",
          "language": "sql",
          "code": "SELECT SUM(revenue) / NULLIF(SUM(units), 0) AS asp\nFROM mx_sales_daily\nWHERE month = :month;",
          "filename": "asp.sql"
        }
      ],
      "subsections": []
    },
