# Build outputs — produced by build.py and CI, not committed.
bin/
_build/
_release/
*.spec
__pycache__/

# Example outputs — regenerated from build_examples.py during CI.
examples/*.docx
examples/*.json

# RAG backend artefacts — regenerated by `mxwp-rules index --backend X`.
# chunks.jsonl + index.lock ARE committed (they're the source-of-truth
# manifest the CI drift check + pre-commit hook compare against).
rag/bm25.json
rag/embeddings.npz
rag/embeddings.jsonl
rag/openai_embeddings.npz
rag/openai_embeddings.jsonl
