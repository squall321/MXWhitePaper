# 위키 작업 워커 이미지 — api.sif 위에 시작 스크립트만 바꿔 python -m app.wiki.worker 를 돌린다(docs/llm-wiki W3 · CONTRACTS §8)
#
# 빌드(build.sh 가 한다 — api.sif 가 더 새것이면 따라 다시 짓는다):
#   apptainer build --force --build-arg API_SIF=$PWD/infra/apptainer/api.sif infra/apptainer/wiki.sif infra/apptainer/wiki.def
Bootstrap: localimage
From: {{ API_SIF }}

%arguments
    API_SIF=infra/apptainer/api.sif

%labels
    Component   mxwp-wiki-worker

%startscript
    cd /workspace/apps/api
    # 접속 주소는 컨테이너 안에서 짓는다 — 비밀(DB 암호 · MinIO 키)을 instance start 명령줄에 싣지 않는다(start.sh 의 api 와 다른 점).
    # 값은 _common.sh 가 .env 를 export 한 환경을 그대로 물려받는다. 주소 꼴은 start.sh 의 api 와 같다.
    export DATABASE_URL="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT:-5432}/${POSTGRES_DB}"
    export MEILI_HOST="http://127.0.0.1:${MEILI_PORT:-7700}"
    export MINIO_ENDPOINT="http://127.0.0.1:${MINIO_API_PORT:-9000}"
    export MINIO_PUBLIC_ENDPOINT="http://127.0.0.1:${MINIO_API_PORT:-9000}"
    # 프록시도 start.sh 의 api 와 같은 규칙으로 — LLM 호출이 api 의 챗과 같은 길로 나간다(값은 물려받은 환경에서).
    _proxy="${HTTPS_PROXY:-${HTTP_PROXY:-${MXWP_FALLBACK_PROXY:-http://168.219.61.252:8080}}}"
    export HTTP_PROXY="$_proxy" HTTPS_PROXY="$_proxy" NO_PROXY="localhost,127.0.0.1,::1"
    # 워커가 죽으면(DB 가 내려감 등) 5초 뒤 다시 띄운다 — 인스턴스에는 이를 대신 살려 줄 감독자가 없다.
    # stop 은 인스턴스째 내리므로 이 고리도 함께 끝난다. 코드를 바꾸면 인스턴스를 다시 띄운다(--reload 가 없다).
    while true; do
        python -m app.wiki.worker
        echo "wiki worker exited ($?) — restarting in 5s" >&2
        sleep 5
    done
