{
 "_note": "틀린 관계 — 없는 술어 · 정의역 밖 · 후보 밖 끝(버린다). V7 이 걸려야 한다",
 "model": "fake-wiki",
 "rules": [
  {
   "match": {
    "schema": "wiki_plan"
   },
   "reply": {
    "json": {
     "summary": "{{summary}}",
     "pages": [
      {
       "slug": "{{cand}}",
       "why": "해석 사례를 담는다."
      },
      {
       "slug": "{{part}}",
       "why": "부품에 해석 결과를 잇는다."
      },
      {
       "slug": "{{fm}}",
       "why": "불량 유형에 재현 해석을 잇는다."
      }
     ],
     "relations": [
      {
       "subject": "{{part}}",
       "predicate": "breaks",
       "object": "{{fm}}",
       "cites": [
        {
         "sid": "{{sid}}",
         "loc": {
          "path": "/"
         }
        }
       ],
       "why": "없는 술어."
      },
      {
       "subject": "{{fm}}",
       "predicate": "part-of",
       "object": "{{cand}}",
       "cites": [
        {
         "sid": "{{sid}}",
         "loc": {
          "path": "/"
         }
        }
       ],
       "why": "정의역 밖(불량 유형은 무엇의 일부가 아니다)."
      },
      {
       "subject": "{{part}}",
       "predicate": "part-of",
       "object": "ent-model-nowhere",
       "cites": [
        {
         "sid": "{{sid}}",
         "loc": {
          "path": "/"
         }
        }
       ],
       "why": "후보 밖 끝."
      }
     ]
    },
    "capture": {
     "cand": "후보: (case-sim-[a-z0-9]+)",
     "part": "후보: (ent-part-[a-z0-9-]+)",
     "fm": "후보: (ent-fm-[a-z0-9-]+)",
     "sid": "<<<원천 (src_[0-9a-f]+)",
     "summary": "\\n요약: ([^\\n]*)"
    },
    "usage": {
     "prompt_tokens": 1400,
     "completion_tokens": 160
    }
   }
  },
  {
   "match": {
    "schema": "wiki_write"
   },
   "reply": {
    "json": {
     "ops": [
      {
       "op": "block.insert",
       "doc": "{{doc}}",
       "section": "{{sec}}",
       "block": {
        "type": "paragraph",
        "text": "{{summary}}"
       },
       "cites": [
        {
         "sid": "{{sid}}",
         "loc": {
          "path": "/"
         }
        }
       ],
       "why": "원천을 옮긴다."
      }
     ]
    },
    "capture": {
     "doc": "\\n문서: ([a-z0-9-]+)",
     "sid": "<<<원천 (src_[0-9a-f]+)",
     "summary": "\\n요약: ([^\\n]*)",
     "sec": "\\n## ([^\\n(]+?) \\(AI\\)"
    },
    "usage": {
     "prompt_tokens": 1500,
     "completion_tokens": 200
    }
   }
  },
  {
   "match": {
    "schema": "wiki_resolve"
   },
   "reply": {
    "json": {
     "choices": []
    }
   },
   "usage": {
    "prompt_tokens": 600,
    "completion_tokens": 10
   }
  }
 ]
}
