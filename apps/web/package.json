    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "d3-force": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "d3-selection": "^3.0.0",
    "katex": "^0.16.45",
    "mathjs": "^15.2.0",
    "mermaid": "^11.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.75.0",
    "react-router-dom": "^6.27.0",
