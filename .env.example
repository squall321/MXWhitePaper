# ────────────────────────────────────────────────────────────────
# MX White Paper — environment template
# Copy to `.env` and adjust per environment. NEVER commit `.env`.
#
# Pre-filled for the 10.252.39.181 deployment with a single shared
# dev password (Soseks314!). For other hosts, search/replace
# 10.252.39.181 → your IP. For production, rotate every secret.
# ────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=info                # debug | info | warn | error

# ── Frontend (Vite) ─────────────────────────────────────────────
VITE_API_URL=http://10.252.39.181:8800/api/v1

# Dashboard provider base URLs — leave blank to render the
# "URL 미설정" placeholder. Used by DashboardEmbedBlock.
VITE_DASHBOARD_GRAFANA_BASE=
VITE_DASHBOARD_TABLEAU_BASE=
VITE_DASHBOARD_SUPERSET_BASE=

# ── Database (PostgreSQL) ───────────────────────────────────────
# Use the server's primary IP so it works whether apptainer shares
# host network or each instance has its own netns.
POSTGRES_USER=mxwp
POSTGRES_PASSWORD=Soseks314!
POSTGRES_DB=mxwp
POSTGRES_HOST=10.252.39.181
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://mxwp:Soseks314!@10.252.39.181:5432/mxwp

# ── Meilisearch ─────────────────────────────────────────────────
MEILI_HOST=http://10.252.39.181:7700
MEILI_PORT=7700
MEILI_MASTER_KEY=Soseks314!

# ── MinIO (S3-compatible storage) ───────────────────────────────
MINIO_ENDPOINT=http://10.252.39.181:9000
MINIO_PUBLIC_ENDPOINT=http://10.252.39.181:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=mxwp_minio_admin
MINIO_SECRET_KEY=Soseks314!
MINIO_BUCKET_IMAGES=mxwp-images
MINIO_BUCKET_FILES=mxwp-files
MINIO_BUCKET_BACKUPS=mxwp-backups

# ── Scheduled backups (in-process asyncio ticker) ───────────────
# Tick every 60s, scan backup_schedules for due rows, zip docs to MinIO.
# Single-replica only — multi-replica needs Celery/k8s CronJob.
BACKUP_ENABLED=true

# ── Service ports (Apptainer host network) ──────────────────────
API_PORT=8800
WEB_PORT=5173

# ── Apptainer command (override if non-standard install) ────────
APPTAINER=apptainer

# ── Apptainer networking — login hangs / ERR_EMPTY_RESPONSE fix ─
# Symptom: external IP loads the page, but login spins forever and
#          browser eventually shows ERR_EMPTY_RESPONSE.
# Cause:   the web container can't reach the host's API port via
#          127.0.0.1 because Apptainer put it in its own netns.
#
# Try these in order — the first that works wins:
#
#   1) VITE_PROXY_TARGET (simplest, no apptainer config needed)
#      Make vite dial the host's primary IP instead of loopback.
#
#   2) MXWP_APPT_HOST_NET=1
#      Pass `--net --network=host` to every instance start. Requires
#      a `host` CNI config in /etc/apptainer/network/ — present on
#      stock 1.3+ installs, absent on some custom builds (see
#      `no net configuration with name "host"` error message).
VITE_PROXY_TARGET=http://10.252.39.181:8800
MXWP_APPT_HOST_NET=0

# Corepack offline mode — keep at 0 unless your network blocks
# registry.npmjs.org outright. Note: web.def now installs pnpm via
# `npm install -g` (corepack removed), so this is mostly a no-op
# but kept for completeness.
MXWP_COREPACK_OFFLINE=0

# Node TLS verification — when 1 (default for prod), node enforces
# normal TLS cert checks. When 0, NODE_TLS_REJECT_UNAUTHORIZED=0 is
# passed to the web container, letting it accept corporate
# SSL-intercepting proxy's MITM cert. Symptom requiring 0:
#   "UNABLE_TO_VERIFY_LEAF_SIGNATURE" during pnpm/corepack startup.
# Insecure — use only behind a trusted corporate proxy.
MXWP_NODE_TLS_VERIFY=0

# ── Corporate proxy (optional) ──────────────────────────────────
# When set, every outbound HTTP(S) call from this stack flows through
# the proxy:
#   - bootstrap-host.sh: pulls .deb / Node tarball / pnpm / pip wheels
#   - build.sh:          OCI registry pulls (docker.io)
#   - start.sh:          forwarded as HTTPS_PROXY into the web/api
#                        containers so pnpm install + pip install work
#
# Set HTTPS_PROXY / HTTP_PROXY here for explicit override, OR rely on
# the MXWP_FALLBACK_PROXY default below (used when no proxy env is
# detected). Set MXWP_FALLBACK_PROXY="" to disable the auto-fallback.
#
# Samsung MX corporate egress (replace with your own when deploying
# elsewhere):
MXWP_FALLBACK_PROXY=http://168.219.61.252:8080
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1,10.252.39.181

# ── Auth (JWT) ──────────────────────────────────────────────────
JWT_SECRET=Soseks314!
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800
JWT_ALGORITHM=HS256

# ── CORS ────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://10.252.39.181:5173,http://10.252.39.181

# ── Limits ──────────────────────────────────────────────────────
IMAGE_MAX_BYTES=20971520      # 20 MB
GALLERY_MAX_BYTES=104857600   # 100 MB
FILE_MAX_BYTES=26214400       # 25 MB — generic file attachments (FileBlock)
RATE_LIMIT_PER_MINUTE=120

# ── Email / SMTP ────────────────────────────────────────────────
# EMAIL_ENABLED=false → app logs the message to stdout under
# "[EMAIL CONSOLE FALLBACK]" instead of opening an SMTP connection.
# Flip to true once SMTP_HOST/USER/PASSWORD are filled in.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=Soseks314!
SMTP_FROM=noreply@mxwhitepaper.local
