# ────────────────────────────────────────────────────────────────
# MX White Paper — environment template
# Copy to `.env` and adjust per environment. NEVER commit `.env`.
#
# Task A (2026-06-07) — 단일 공유 dev password 가 5 service 의 인증
# (postgres / meili / minio / jwt / smtp) 을 모두 보호하던 구조에서
# 각 service 별 *독립* CHANGE_ME_* placeholder 로 분리. `.env` 복사 후
# **반드시** 각 placeholder 를 별도 강한 secret 으로 교체. install.sh
# (또는 infra/scripts/start.sh) 가 CHANGE_ME 잔존 시 abort.
#
# Production 으로 가져갈 때:
#   - `pwgen -s 32 1` 또는 `openssl rand -base64 24` 로 secret 생성
#   - 5 placeholder (POSTGRES / MEILI / MINIO / JWT / SMTP) 모두 교체
#   - DATABASE_URL 안의 password 부분도 같이 교체
#   - `git diff` 로 placeholder 잔존 안 했는지 더블체크
#
# For other hosts, search/replace 10.252.39.181 → your IP.
# ────────────────────────────────────────────────────────────────

# ── App ─────────────────────────────────────────────────────────
APP_ENV=development           # development | production
LOG_LEVEL=info                # debug | info | warn | error

# ── Frontend (Vite) ─────────────────────────────────────────────
# NOTE: only used by the DEV server (`apptainer run` / vite dev). In production behind the HWAX
# portal the SPA is a prebuilt static bundle and the API is reached as a SAME-ORIGIN relative path
# (/mx-white-paper/api/v1 → portal nginx → :8800), so NO IP is needed. Leave this for dev only, or
# blank to let the FE default to `${BASE_URL}api/v1`. Behind the portal it is irrelevant.
VITE_API_URL=http://localhost:8800/api/v1

# Dashboard provider base URLs — leave blank to render the
# "URL 미설정" placeholder. Used by DashboardEmbedBlock.
VITE_DASHBOARD_GRAFANA_BASE=
VITE_DASHBOARD_TABLEAU_BASE=
VITE_DASHBOARD_SUPERSET_BASE=

# ── Database (PostgreSQL) ───────────────────────────────────────
# Use the server's primary IP so it works whether apptainer shares
# host network or each instance has its own netns.
POSTGRES_USER=mxwp
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=mxwp
# 로컬 호스트의 mxwp_postgres 인스턴스를 가리킴 (host 측 expose port = 5532).
# 다른 호스트의 DB 를 쓰려면 IP 와 port (5432 등) 둘 다 바꿔야 한다.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5532
DATABASE_URL=postgresql+asyncpg://mxwp:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5532/mxwp

# ── Meilisearch ─────────────────────────────────────────────────
MEILI_HOST=http://10.252.39.181:7700
MEILI_PORT=7700
MEILI_MASTER_KEY=CHANGE_ME_MEILI_MASTER_KEY

# ── MinIO (S3-compatible storage) ───────────────────────────────
# MINIO_ENDPOINT: API 가 내부에서 쓰는 주소. MINIO_PUBLIC_ENDPOINT: 브라우저가
# <img src> 로 이미지를 직접 받는 주소 (anonymous-read 버킷). 포탈 뒤에 서빙할 때는
# 브라우저가 닿는 경로여야 한다 — origin-상대 서브경로로 두고 포탈이 MinIO 를 프록시한다
# (infra/nginx/minio.conf.example 참고). 예: MINIO_PUBLIC_ENDPOINT=/mx-white-paper/minio
MINIO_ENDPOINT=http://10.252.39.181:9000
MINIO_PUBLIC_ENDPOINT=http://10.252.39.181:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=mxwp_minio_admin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_IMAGES=mxwp-images
MINIO_BUCKET_FILES=mxwp-files
MINIO_BUCKET_BACKUPS=mxwp-backups

# ── Scheduled backups (in-process asyncio ticker) ───────────────
# Tick every 60s, scan backup_schedules for due rows, zip docs to MinIO.
# Single-replica only — multi-replica needs Celery/k8s CronJob.
BACKUP_ENABLED=true

# ── Service ports (Apptainer host network) ──────────────────────
API_PORT=8800
WEB_PORT=5173

# ── Behind the HWAX portal (sub-path serving) ───────────────────
# Leave empty for standalone (served at "/"). To run UNDER the HWAX portal, which reverse-proxies
# https://hwax.sec.samsung.net/mx-white-paper/ → this web instance (prefix passed through), set:
#   MXWP_BASE_PATH=/mx-white-paper/
# start.sh threads it into the web build+preview as VITE_BASE_PATH (assets/router) and derives
# VITE_API_URL=<prefix>api/v1. The instance then builds the SPA and serves it via `vite preview`.
MXWP_BASE_PATH=

# ── Apptainer command (override if non-standard install) ────────
APPTAINER=apptainer

# ── Apptainer networking — login hangs / ERR_EMPTY_RESPONSE fix ─
# Symptom: external IP loads the page, but login spins forever and
#          browser eventually shows ERR_EMPTY_RESPONSE.
# Cause:   the web container can't reach the host's API port via
#          127.0.0.1 because Apptainer put it in its own netns.
#
# Try these in order — the first that works wins:
#
#   1) VITE_PROXY_TARGET (simplest, no apptainer config needed)
#      Make vite dial the host's primary IP instead of loopback.
#
#   2) MXWP_APPT_HOST_NET=1
#      Pass `--net --network=host` to every instance start. Requires
#      a `host` CNI config in /etc/apptainer/network/ — present on
#      stock 1.3+ installs, absent on some custom builds (see
#      `no net configuration with name "host"` error message).
# DEV-SERVER ONLY (vite dev proxy → API). Production (build+serve behind the portal) does not use
# this — the portal routes /mx-white-paper/api → :8800. Same-host services need no IP, just localhost.
VITE_PROXY_TARGET=http://localhost:8800
MXWP_APPT_HOST_NET=0

# Corepack offline mode — keep at 0 unless your network blocks
# registry.npmjs.org outright. Note: web.def now installs pnpm via
# `npm install -g` (corepack removed), so this is mostly a no-op
# but kept for completeness.
MXWP_COREPACK_OFFLINE=0

# Node TLS verification — when 1 (default for prod), node enforces
# normal TLS cert checks. When 0, NODE_TLS_REJECT_UNAUTHORIZED=0 is
# passed to the web container, letting it accept corporate
# SSL-intercepting proxy's MITM cert. Symptom requiring 0:
#   "UNABLE_TO_VERIFY_LEAF_SIGNATURE" during pnpm/corepack startup.
# Insecure — use only behind a trusted corporate proxy.
MXWP_NODE_TLS_VERIFY=0

# ── Corporate proxy (optional) ──────────────────────────────────
# When set, every outbound HTTP(S) call from this stack flows through
# the proxy:
#   - bootstrap-host.sh: pulls .deb / Node tarball / pnpm / pip wheels
#   - build.sh:          OCI registry pulls (docker.io)
#   - start.sh:          forwarded as HTTPS_PROXY into the web/api
#                        containers so pnpm install + pip install work
#
# Set HTTPS_PROXY / HTTP_PROXY here for explicit override, OR rely on
# the MXWP_FALLBACK_PROXY default below (used when no proxy env is
# detected). Set MXWP_FALLBACK_PROXY="" to disable the auto-fallback.
#
# Samsung MX corporate egress (replace with your own when deploying
# elsewhere):
MXWP_FALLBACK_PROXY=http://168.219.61.252:8080
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1,10.252.39.181

# ── Graph triple 추출 (graph-edge-predicates) ───────────────────
# 그래프 의미 엣지 (subject, predicate, object) 의 LLM 추출 provider.
#   mock   (기본): 본문 [[slug]] 1~2 개를 placeholder triple 로. 외부 호출 X.
#   ollama : 로컬 ollama 호환 HTTP API (POST /api/chat) 로 실 추출.
#   openai : ollama 와 동일 경로 — ollama 호환 엔드포인트로 호출.
# 주의: ollama/openai 라도 엔드포인트에 도달 못 하면 (연결 실패/타임아웃/
#       응답 이상) mock 으로 자동 폴백한다 — LLM 없는 환경에서도 /extract 무중단.
# 자동 셋업: ./infra/scripts/setup-llm.sh 가 GPU 를 감지해 ollama 설치 + 모델
#           pull + 이 값을 알아서 채운다 (install-host-deps.sh Step 6 에서 호출).
TRIPLE_EXTRACTOR_PROVIDER=mock
# provider=ollama/openai 일 때 호출할 LLM HTTP 엔드포인트 (스킴+호스트+포트).
# 예: 로컬 ollama 기본값. 미설정 시 http://localhost:11434.
TRIPLE_EXTRACTOR_ENDPOINT=http://localhost:11434
# 추출 모델 이름. ollama 면 'llama3' 등 pull 된 모델, openai 호환이면 모델 ID.
TRIPLE_EXTRACTOR_MODEL=gpt-4o-mini
# 이 신뢰도 미만의 triple 은 추출 결과에서 자동 drop (LLM provider 만 적용).
TRIPLE_EXTRACTOR_MIN_CONFIDENCE=0.5

# ── Auth (JWT) ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800
JWT_ALGORITHM=HS256

# ── CORS ────────────────────────────────────────────────────────
# Audit fix H5 — portal 뒤에서 SPA 가 https://hwax.sec.samsung.net/mx-white-paper/
# origin 으로 /mx-white-paper/api/* 를 호출하면 preflight 가 거부된다.
# portal 모드에서는 아래 리스트에 portal origin 도 반드시 추가:
#   CORS_ORIGINS=...,https://hwax.sec.samsung.net
# nginx 가 /mx-white-paper/api → :8800 으로 path-rewriting 만 하고 Host/Origin
# header 는 그대로 forward 하므로, API 가 보는 Origin 은 portal 의 origin.
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://10.252.39.181:5173,http://10.252.39.181

# ── Limits ──────────────────────────────────────────────────────
IMAGE_MAX_BYTES=20971520      # 20 MB
GALLERY_MAX_BYTES=104857600   # 100 MB
FILE_MAX_BYTES=26214400       # 25 MB — generic file attachments (FileBlock)
RATE_LIMIT_PER_MINUTE=120

# ── Email / SMTP ────────────────────────────────────────────────
# EMAIL_ENABLED=false → app logs the message to stdout under
# "[EMAIL CONSOLE FALLBACK]" instead of opening an SMTP connection.
# Flip to true once SMTP_HOST/USER/PASSWORD are filled in.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@mxwhitepaper.local

# ── Data merge via Google Drive (선택) ──────────────────────────
# data-dump-to-drive.sh / data-merge-from-drive.sh 가 읽는다.
# rclone 설치 + 'rclone config' 로 Drive remote alias 설정 후 아래 값 채움.
# 형식: <remote-alias>:<path>
# 예: MxwpDrive:MXWhitePaper/data-dumps
MXWP_DRIVE_REMOTE=
# 가장 최근 dump N 개만 Drive 에 유지 (0 = keep all)
MXWP_DRIVE_RETAIN=5

# ── Built .sif images via Drive (for cae00: no npm/Docker-Hub) ───────────────
# Same rclone remote as above, different path. Build web.sif online (dist baked in) →
# images-to-drive.sh; on cae00 → images-from-drive.sh + start.sh (no build).
# 예: MxwpDrive:MXWhitePaper/images
MXWP_IMAGES_REMOTE=
MXWP_IMAGES_RETAIN=3

# ── llm-docx-toolkit 바이너리(tarball) via Drive ─────────────────────────────
# sif 와 같은 메커니즘 — 미설정 시 MXWP_IMAGES_REMOTE 의 /images 를 /toolkit 으로 자동 치환.
# online: make ship-toolkit  →  cae00: make pull-toolkit (받아 추출).
MXWP_TOOLKIT_REMOTE=
MXWP_TOOLKIT_RETAIN=3

# ── HWAX Portal SSO (true single sign-on) ───────────────────────────────────
# Set these to accept launch tokens from the HWAX portal (login on the portal → land here logged
# in, no second login). Empty PORTAL_JWKS_URL keeps SSO disabled (callback returns 404).
#   PORTAL_JWKS_URL    portal's public keys. cae00 (host network): http://localhost:8723/.well-known/jwks.json
#   PORTAL_AUDIENCE    token aud we accept (must match systems.yaml audience for this service)
#   REFRESH_COOKIE_PATH  set "/" behind the portal so the refresh cookie reaches /mx-white-paper/api/v1/auth
PORTAL_JWKS_URL=
PORTAL_AUDIENCE=mx-white-paper
PORTAL_SSO_DEFAULT_ROLE=editor
PORTAL_SSO_LANDING=/mx-white-paper/
# REFRESH_COOKIE_PATH=/
